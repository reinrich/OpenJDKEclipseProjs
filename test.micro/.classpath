<?xml version="1.0" encoding="UTF-8"?>
<classpath>
	<classpathentry kind="src" path="test.micro"/>
	<classpathentry combineaccessrules="false" kind="src" path="/java.base">
		<attributes>
			<attribute name="module" value="true"/>
			<attribute name="add-exports" value="java.base/jdk.internal.vm=ALL-UNNAMED"/>
		</attributes>
	</classpathentry>
	<classpathentry combineaccessrules="false" kind="src" path="/jmh"/>
	<classpathentry kind="output" path="bin"/>
</classpath>
